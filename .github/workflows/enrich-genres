name: Enrich genres (Wikidata)

# Holt fehlende Artist-Genres aus Wikidata (CC0, frei nutzbar) und baut dann
# festivals.json neu. Läuft wöchentlich + manuell. Kein Spotify, keine Secrets.
# Datei-Pfad im Repo: .github/workflows/enrich-genres.yml

on:
  schedule:
    - cron: '0 4 * * 1'      # wöchentlich Montag 04:00 UTC – neue Artists nachziehen
  workflow_dispatch:          # manuell startbar

permissions:
  contents: write

concurrency:
  group: enrich-genres
  cancel-in-progress: false

jobs:
  enrich:
    runs-on: ubuntu-latest
    timeout-minutes: 60
    steps:
      - uses: actions/checkout@v4

      - uses: actions/setup-python@v5
        with:
          python-version: '3.12'

      # Erst Artists mit den Line-ups synchronisieren (neue Stubs anlegen,
      # Spotify-Reste entfernen), dann Genres aus Wikidata ergänzen.
      - name: Artists synchronisieren
        run: python3 sync_artists.py

      - name: Genres aus Wikidata anreichern
        env:
          PYTHONUNBUFFERED: "1"
        run: python3 -u enrich_genres.py

      - name: festivals.json bauen (Join)
        run: python3 build_festivals.py

      - name: Änderungen committen (nur bei Änderung)
        run: |
          git config user.name "github-actions[bot]"
          git config user.email "github-actions[bot]@users.noreply.github.com"
          git add artists festivals.json
          git diff --staged --quiet || git commit -m "Auto: Genres (Wikidata) + festivals.json gebaut"
          git push
